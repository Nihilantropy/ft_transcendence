# Root compose-level configuration. Copy to .env and adjust.
# Docker Compose reads this file automatically for ${VAR} interpolation.

# Which stack to run:
#   local = GPU (ollama + classification-service)   [default via Makefile]
#   cloud = LiteLLM-only, hosted API key, no GPU
COMPOSE_PROFILES=local

# LiteLLM proxy auth — must match srcs/ai/.env LLM_API_KEY
LITELLM_MASTER_KEY=sk-smartbreeds-local

# Local Ollama endpoint used by LiteLLM (only relevant in the `local` profile)
OLLAMA_BASE_URL=http://ollama:11434

# Hosted provider key — required only in cloud mode (Mistral/Pixtral for vision).
# Leave empty when running the local profile.
MISTRAL_API_KEY=
