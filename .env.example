# Root compose-level configuration. Copy to .env and adjust.
# Docker Compose reads this file automatically for ${VAR} interpolation.

# Which stack to run:
#   cloud = hosted LLM (Mistral via LiteLLM), no GPU needed.   [default]
#           classification-service still runs, on CPU.
#   local = GPU machine: adds Ollama as the LLM backend.
# Note: the Makefile sets `COMPOSE_PROFILES ?= cloud` and exports it, which
# takes precedence over this value whenever you go through `make`.
COMPOSE_PROFILES=cloud

# LiteLLM proxy auth — must match srcs/ai/.env LLM_API_KEY
LITELLM_MASTER_KEY=sk-smartbreeds-local

# Local Ollama endpoint used by LiteLLM (only relevant in the `local` profile)
OLLAMA_BASE_URL=http://ollama:11434

# Hosted LLM key — REQUIRED in the default cloud profile. Without it every LLM
# call fails, which takes down the vision analysis and the RAG answers.
# A free-tier key works: srcs/litellm/config.yaml deliberately uses models the
# free tier can actually call (ministral-*), with retries and a fallback model
# for its rate limits. See that file before switching models — several listed
# by the API have a free-tier limit of 0 requests/minute.
MISTRAL_API_KEY=
