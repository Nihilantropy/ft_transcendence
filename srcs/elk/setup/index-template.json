{
  "index_patterns": ["logs-smartbreeds-*"],
  "data_stream": {},
  "priority": 200,
  "template": {
    "settings": {
      "number_of_replicas": 0,
      "index.lifecycle.name": "smartbreeds-logs"
    },
    "mappings": {
      "properties": {
        "@timestamp": { "type": "date" },
        "message": { "type": "text" },
        "level": { "type": "keyword" },
        "service": { "type": "keyword" },
        "container": {
          "properties": {
            "name": { "type": "keyword" },
            "image": { "properties": { "name": { "type": "keyword" } } }
          }
        }
      }
    }
  }
}
