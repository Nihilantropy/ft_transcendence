# Django Settings
DEBUG=False
SECRET_KEY=CHANGE_THIS_TO_SECURE_RANDOM_STRING
ALLOWED_HOSTS=auth-service,localhost

# Database
DB_NAME=smartbreeds
DB_USER=smartbreeds_user
DB_PASSWORD=secure_password_here
DB_HOST=db
DB_PORT=5432

# JWT Configuration (RS256 Asymmetric)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_PRIVATE_KEY_PATH=/app/keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=/app/keys/jwt-public.pem

# Two-Factor Authentication (TOTP)
TWO_FACTOR_ISSUER=SmartBreeds
# Fernet key that encrypts TOTP secrets at rest. Empty derives one from SECRET_KEY, so changing
# SECRET_KEY then makes every stored secret undecryptable. Generate a dedicated key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TWO_FACTOR_ENCRYPTION_KEY=
TWO_FACTOR_WINDOW=1
TWO_FACTOR_MAX_ATTEMPTS=5
TWO_FACTOR_LOCKOUT_MINUTES=15
TWO_FACTOR_CHALLENGE_LIFETIME_MINUTES=5

# OAuth 2.0 — "Log in with 42" (see README.md, "Create the 42 application and fill .env").
# Leave the id and secret empty and the button explains that 42 login is unavailable; everything
# else works. Never commit real values: this file is tracked, .env is not.
OAUTH_42_CLIENT_ID=
OAUTH_42_CLIENT_SECRET=
# Must be exactly the Redirect URI registered on the intra
OAUTH_42_REDIRECT_URI=https://localhost:8443/api/v1/auth/oauth/42/callback

# Cookie Settings
COOKIE_SECURE=False
COOKIE_SAMESITE=Strict
COOKIE_DOMAIN=localhost

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Microservices URLs
USER_SERVICE_URL=http://user-service:3002