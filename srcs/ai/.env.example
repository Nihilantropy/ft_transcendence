# LLM inference via LiteLLM proxy (OpenAI-compatible)
LLM_BASE_URL=http://litellm:4000/v1
LLM_API_KEY=sk-smartbreeds-local            # must match LiteLLM LITELLM_MASTER_KEY
# Which LiteLLM aliases to use (resolved in srcs/litellm/config.yaml):
#   Cloud (default — no GPU, needs MISTRAL_API_KEY in the root .env):
#       vision-model-cloud / text-model-cloud
#   Local (GPU machine, `local` compose profile, Ollama):
#       vision-model / text-model
LLM_VISION_MODEL=vision-model-cloud
LLM_TEXT_MODEL=text-model-cloud
LLM_TIMEOUT=300
LLM_TEMPERATURE=0.1

# Full pipeline: NSFW filter + HuggingFace species/breed classifiers, then RAG
# and the LLM. classification-service now runs in every stack on CPU (GPU only
# via docker-compose.gpu.yml), so keep this `true` in both profiles.
#   false -> VLM-only fallback: the LLM guesses species/breed itself and there
#            is NO NSFW filter. Only for debugging without classification-service.
CLASSIFICATION_ENABLED=true

# Image Processing
MAX_IMAGE_SIZE_MB=5
MAX_IMAGE_DIMENSION=1024
MIN_IMAGE_DIMENSION=224

# Vision Analysis Thresholds
LOW_CONFIDENCE_THRESHOLD=0.5
SPECIES_MIN_CONFIDENCE=0.10
BREED_MIN_CONFIDENCE=0.05

# Service Configuration
SERVICE_NAME=ai-service
LOG_LEVEL=info
