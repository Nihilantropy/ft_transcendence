# LLM inference via LiteLLM proxy (OpenAI-compatible)
LLM_BASE_URL=http://litellm:4000/v1
LLM_API_KEY=sk-smartbreeds-local            # must match LiteLLM LITELLM_MASTER_KEY
# Local (GPU, `local` compose profile): vision-model / text-model
# Cloud (API key, no GPU): vision-model-cloud / text-model-cloud  (+ set MISTRAL_API_KEY)
LLM_VISION_MODEL=vision-model
LLM_TEXT_MODEL=text-model
LLM_TIMEOUT=300
LLM_TEMPERATURE=0.1

# Classification service (HF models + GPU).
# true  -> full pipeline (NSFW + species + breed via classification-service, `local` profile)
# false -> VLM-only pipeline (vision LLM does species/breed; NSFW filter DISABLED)
CLASSIFICATION_ENABLED=true

# Image Processing
MAX_IMAGE_SIZE_MB=5
MAX_IMAGE_DIMENSION=1024
MIN_IMAGE_DIMENSION=224

# Vision Analysis Thresholds
LOW_CONFIDENCE_THRESHOLD=0.5
SPECIES_MIN_CONFIDENCE=0.10
BREED_MIN_CONFIDENCE=0.05

# Service Configuration
SERVICE_NAME=ai-service
LOG_LEVEL=info
