    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "i18next": "^26.2.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "ky": "^2.0.2",
    "lucide-react": "^1.16.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-dropzone": "^15.0.0",
    "react-hook-form": "^7.76.0",
    "react-i18next": "^17.0.8",
    "react-router": "^7.15.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
